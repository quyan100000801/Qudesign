RewriteEngine On
RewriteRule ^projects$ projects.html [L]
RewriteRule ^project/([0-9]+)$ project-detail.html?id=$1 [L]
RewriteRule ^admin$ admin.html [L]

# ===== 缓存策略 =====
<IfModule mod_headers.c>
    # 页面、脚本、接口：每次向服务器校验，改了立即生效，没变返回304（几乎零开销）
    <FilesMatch "\.(html|js|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # 图片、视频、字体：文件名带时间戳、内容不变，长缓存一年
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|mp4|webm|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
